<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>{% block title %}CMFit{% endblock %}</title>
    
    <!-- FontAwesome Pro Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous">
    
    <!-- Tailwind CSS Engine -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Custom Theme Design System -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}?v=1.0.0">
</head>
<body class="ios-body-wrapper bg-slate-950 min-h-full flex flex-col text-slate-100 antialiased selection:bg-emerald-500 selection:text-slate-950 !overflow-visible">

    <!-- Top Navigation Header -->
    <header class="ios-header sticky top-0 z-40 bg-slate-950/80 backdrop-blur-md border-b border-white/5 px-4 py-3">
        <div class="cmfit-header-row">
        <a href="{{ url_for('workout_list') }}" class="flex items-center gap-3.5 active:scale-95 transition-transform duration-150">
            <div class="brand-logo-icon flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 font-bold text-sm">
                CM
            </div>
            <div class="flex flex-col justify-center">
                <span class="brand-title text-sm font-bold leading-tight">CMFit</span>
                <span class="brand-subtitle text-[10px] text-slate-400 tracking-wider uppercase leading-tight">Performance</span>
            </div>
        </a>
        <button type="button" id="cmfitChatOpen" class="cmfit-chat-header-btn" aria-label="Open CMFit chat">
            <i class="fa-solid fa-comment-dots"></i>
        </button>
        </div>
    </header>

    <!-- Main Scrollable Content Body -->
    <main class="ios-main-content flex-1 px-4 pt-4 pb-24 max-w-lg mx-auto w-full !overflow-visible">
        {% block content %}{% endblock %}
    </main>

    <!-- Fixed Bottom Navigation Dock -->
    <div class="fixed bottom-0 left-0 right-0 z-50">
        <nav class="max-w-lg mx-auto bg-slate-950/90 backdrop-blur-2xl border-t border-white/10 px-2 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] flex items-center justify-around shadow-[0_-8px_30px_rgba(0,0,0,0.85)]">
            
            <!-- Exercises -->
            <a href="{{ url_for('exercise_list') }}" 
               class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all duration-200 active:scale-95 {{ 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' if request.endpoint in ['exercise_list', 'display_exercise', 'add_exercise', 'edit_exercise'] else 'text-slate-400 hover:text-slate-200 hover:bg-white/5 font-medium' }}">
                <i class="fa-solid fa-dumbbell text-base mb-1"></i>
                <span class="text-[10px] tracking-wider uppercase">Exercises</span>
            </a>

            <!-- Workouts -->
            <a href="{{ url_for('workout_list') }}" 
               class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all duration-200 active:scale-95 {{ 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' if request.endpoint in ['workout_list', 'index', 'view_workout', 'add_workout', 'start_workout', 'reorder_workout_exercises'] else 'text-slate-400 hover:text-slate-200 hover:bg-white/5 font-medium' }}">
                <i class="fa-solid fa-list-check text-base mb-1"></i>
                <span class="text-[10px] tracking-wider uppercase">Workouts</span>
            </a>

            <!-- Progress -->
            {% set progress_endpoint = 'progress' if 'progress' in url_map else ('workout_progress' if 'workout_progress' in url_map else 'progress') %}
            <a href="{{ url_for(progress_endpoint) }}" 
               class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all duration-200 active:scale-95 {{ 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' if request.endpoint in ['progress', 'workout_progress', 'history', 'logs'] else 'text-slate-400 hover:text-slate-200 hover:bg-white/5 font-medium' }}">
                <i class="fa-solid fa-chart-line text-base mb-1"></i>
                <span class="text-[10px] tracking-wider uppercase">Progress</span>
            </a>

            <!-- Plan -->
            <a href="{{ url_for('plan') }}"
               class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all duration-200 active:scale-95 {{ 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' if request.endpoint in ['plan', 'create_plan', 'save_plan', 'delete_plan'] else 'text-slate-400 hover:text-slate-200 hover:bg-white/5 font-medium' }}">
                <i class="fa-solid fa-route text-base mb-1"></i>
                <span class="text-[10px] tracking-wider uppercase">Plan</span>
            </a>

            <!-- Admin -->
            {% set admin_endpoint = 'admin' if 'admin' in url_map else ('settings' if 'settings' in url_map else 'admin') %}
            <a href="{{ url_for(admin_endpoint) }}" 
               class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all duration-200 active:scale-95 {{ 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' if request.endpoint in ['admin', 'settings', 'sound_settings', 'config'] else 'text-slate-400 hover:text-slate-200 hover:bg-white/5 font-medium' }}">
                <i class="fa-solid fa-sliders text-base mb-1"></i>
                <span class="text-[10px] tracking-wider uppercase">Admin</span>
            </a>

        </nav>
    </div>


    <!-- Global CMFit Chat Drawer -->
    <div id="cmfitChatBackdrop" class="cmfit-chat-backdrop hidden" aria-hidden="true"></div>
    <section id="cmfitChatDrawer" class="cmfit-chat-drawer" aria-hidden="true" aria-label="CMFit assistant">
        <div class="cmfit-chat-head">
            <div>
                <span class="cmfit-chat-kicker"><i class="fa-solid fa-sparkles"></i> CMFIT ASSISTANT</span>
                <strong id="cmfitChatTitle">Chat</strong>
                <small id="cmfitChatContext">Ask about workouts, progress, exercises, or make changes.</small>
            </div>
            <button type="button" id="cmfitChatClose" class="cmfit-chat-close" aria-label="Close chat"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="cmfitChatMessages" class="cmfit-chat-messages" aria-live="polite"></div>
        <div id="cmfitVoiceStatus" class="cmfit-voice-status hidden"><i class="fa-solid fa-wave-square"></i> Listening…</div>
        <form id="cmfitChatForm" class="cmfit-chat-compose">
            <button type="button" id="cmfitChatMic" class="cmfit-chat-mic" aria-label="Voice command"><i class="fa-solid fa-microphone"></i></button>
            <textarea id="cmfitChatInput" rows="1" placeholder="Message CMFit…" autocomplete="off"></textarea>
            <button type="submit" id="cmfitChatSend" class="cmfit-chat-send" aria-label="Send"><i class="fa-solid fa-arrow-up"></i></button>
        </form>
    </section>

    <!-- Audio Engine Scripts -->
    <script>
        window.CMFitSoundConfig = {{ sound_config | tojson | safe if sound_config is defined else '{}' }};
        window.audioCache = {};
        window.soundBuffers = {};
        let audioCtx = null;

        function getSoundDetails(type) {
            const cfg = window.CMFitSoundConfig || {};
            const mappings = {
                'start': { enabled: !!cfg.start_enabled, url: cfg.start_url },
                'notice': { enabled: !!cfg.notice_enabled, url: cfg.notice_url },
                'rest_end': { enabled: !!cfg.rest_end_enabled, url: cfg.rest_end_url },
                'end': { enabled: !!cfg.end_enabled, url: cfg.end_url }
            };
            return mappings[type] || { enabled: false, url: null };
        }

        function initAudioEngine() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (AudioContextClass) audioCtx = new AudioContextClass();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            ['start', 'notice', 'rest_end', 'end'].forEach(type => {
                const details = getSoundDetails(type);
                if (details.enabled && details.url && !window.audioCache[type]) {
                    const audioObj = new Audio(details.url);
                    audioObj.preload = 'auto';
                    window.audioCache[type] = audioObj;

                    if (audioCtx) {
                        fetch(details.url)
                            .then(res => res.arrayBuffer())
                            .then(buf => audioCtx.decodeAudioData(buf))
                            .then(decoded => { window.soundBuffers[type] = decoded; })
                            .catch(e => console.warn('WebAudio fallback for', type, e));
                    }
                }
            });
        }

        function unlockAudio() {
            initAudioEngine();
            Object.keys(window.audioCache).forEach(k => {
                const sound = window.audioCache[k];
                sound.muted = true;
                sound.play().then(() => {
                    sound.pause();
                    sound.currentTime = 0;
                    sound.muted = false;
                }).catch(() => { sound.muted = false; });
            });
            document.removeEventListener('touchstart', unlockAudio);
            document.removeEventListener('click', unlockAudio);
        }

        document.addEventListener('touchstart', unlockAudio, { once: true, passive: true });
        document.addEventListener('click', unlockAudio, { once: true, passive: true });

        window.playCMFitSound = function(type) {
            const details = getSoundDetails(type);
            if (!details.enabled || !details.url) return;

            // Strategy 1: High-performance Web Audio API Buffer
            if (audioCtx && window.soundBuffers[type]) {
                try {
                    if (audioCtx.state === 'suspended') audioCtx.resume();
                    const source = audioCtx.createBufferSource();
                    source.buffer = window.soundBuffers[type];
                    source.connect(audioCtx.destination);
                    source.start(0);
                    return;
                } catch(e) {
                    console.warn('WebAudio play failed, using fallback audio element', e);
                }
            }

            // Strategy 2: Preloaded HTML5 Audio Tag Fallback
            let audio = window.audioCache[type];
            if (!audio) {
                audio = new Audio(details.url);
                window.audioCache[type] = audio;
            }
            audio.currentTime = 0;
            audio.play().catch(e => console.error('Audio play error:', e));
        };
    </script>

    <script>
    (function () {
        const drawer = document.getElementById('cmfitChatDrawer');
        const backdrop = document.getElementById('cmfitChatBackdrop');
        const openBtn = document.getElementById('cmfitChatOpen');
        const closeBtn = document.getElementById('cmfitChatClose');
        const form = document.getElementById('cmfitChatForm');
        const input = document.getElementById('cmfitChatInput');
        const mic = document.getElementById('cmfitChatMic');
        const send = document.getElementById('cmfitChatSend');
        const messagesEl = document.getElementById('cmfitChatMessages');
        const titleEl = document.getElementById('cmfitChatTitle');
        const contextEl = document.getElementById('cmfitChatContext');
        const voiceStatus = document.getElementById('cmfitVoiceStatus');
        const storageKey = 'cmfit-chat-history-v1';
        let context = { mode: 'global' };
        let recognition = null;
        let listening = false;
        let messages = [];

        try { messages = JSON.parse(sessionStorage.getItem(storageKey) || '[]'); } catch (_) { messages = []; }
        messages = Array.isArray(messages) ? messages.slice(-20) : [];

        function escapeHtml(value) {
            const div = document.createElement('div');
            div.textContent = value == null ? '' : String(value);
            return div.innerHTML;
        }
        function persist() { sessionStorage.setItem(storageKey, JSON.stringify(messages.slice(-20))); }
        function render() {
            messagesEl.innerHTML = messages.length ? messages.map(m =>
                '<div class="cmfit-chat-bubble cmfit-chat-' + m.role + '">' + escapeHtml(m.content) + '</div>'
            ).join('') : '<div class="cmfit-chat-empty"><i class="fa-solid fa-comment-dots"></i><strong>How can I help?</strong><span>You can type or use the microphone.</span></div>';
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }
        function setContext(next) {
            context = next || { mode: 'global' };
            if (context.mode === 'workout_set') {
                titleEl.textContent = 'Log Set by Voice';
                contextEl.textContent = (context.exercise_name || 'Current exercise') + (context.set_number ? ' · Set ' + context.set_number : '');
            } else {
                titleEl.textContent = 'Chat';
                contextEl.textContent = 'Ask about workouts, progress, exercises, or make changes.';
            }
        }
        function openChat(nextContext, startVoice) {
            setContext(nextContext || { mode: 'global' });
            drawer.classList.add('cmfit-chat-open');
            drawer.setAttribute('aria-hidden', 'false');
            backdrop.classList.remove('hidden');
            backdrop.setAttribute('aria-hidden', 'false');
            render();
            if (startVoice) setTimeout(startListening, 220); else setTimeout(() => input.focus(), 220);
        }
        function closeChat() {
            stopListening();
            drawer.classList.remove('cmfit-chat-open');
            drawer.setAttribute('aria-hidden', 'true');
            backdrop.classList.add('hidden');
            backdrop.setAttribute('aria-hidden', 'true');
        }
        async function sendMessage(text) {
            text = (text || '').trim();
            if (!text) return;
            messages.push({ role: 'user', content: text });
            messages = messages.slice(-20); persist(); render(); input.value = '';
            send.disabled = true; mic.disabled = true;
            const pending = document.createElement('div');
            pending.className = 'cmfit-chat-bubble cmfit-chat-assistant cmfit-chat-thinking';
            pending.textContent = 'Working…';
            messagesEl.appendChild(pending); messagesEl.scrollTop = messagesEl.scrollHeight;
            try {
                const response = await fetch({{ url_for('chat')|tojson }}, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messages: messages, context: context })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Chat request failed');
                messages.push({ role: 'assistant', content: data.message || 'Done.' });
                messages = messages.slice(-20); persist(); render();
                if (context.mode === 'workout_set' && Array.isArray(data.tool_calls) && data.tool_calls.some(x => x.name === 'log_set')) {
                    setTimeout(() => window.location.reload(), 650);
                }
            } catch (error) {
                pending.remove();
                messages.push({ role: 'assistant', content: 'Error: ' + error.message });
                persist(); render();
            } finally { send.disabled = false; mic.disabled = false; }
        }
        function setupRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) return null;
            const r = new SpeechRecognition();
            r.lang = 'en-US'; r.interimResults = true; r.continuous = false;
            r.onstart = () => { listening = true; mic.classList.add('cmfit-mic-listening'); voiceStatus.classList.remove('hidden'); };
            r.onresult = event => {
                let transcript = '';
                for (let i = event.resultIndex; i < event.results.length; i++) transcript += event.results[i][0].transcript;
                input.value = transcript.trim();
                if (event.results[event.results.length - 1].isFinal) sendMessage(input.value);
            };
            r.onerror = event => { if (event.error !== 'aborted') contextEl.textContent = 'Voice error: ' + event.error + '. You can still type.'; };
            r.onend = () => { listening = false; mic.classList.remove('cmfit-mic-listening'); voiceStatus.classList.add('hidden'); };
            return r;
        }
        function startListening() {
            if (!recognition) recognition = setupRecognition();
            if (!recognition) { contextEl.textContent = 'Voice recognition is not available in this browser. You can still type.'; input.focus(); return; }
            if (listening) { stopListening(); return; }
            try { recognition.start(); } catch (_) {}
        }
        function stopListening() { if (recognition && listening) try { recognition.stop(); } catch (_) {} }

        openBtn.addEventListener('click', () => openChat({ mode: 'global' }, false));
        closeBtn.addEventListener('click', closeChat); backdrop.addEventListener('click', closeChat);
        mic.addEventListener('click', startListening);
        form.addEventListener('submit', event => { event.preventDefault(); sendMessage(input.value); });
        input.addEventListener('keydown', event => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); sendMessage(input.value); } });
        render();

        window.CMFitChat = {
            open: () => openChat({ mode: 'global' }, false),
            openWorkoutVoice: data => openChat({ mode: 'workout_set', ...data }, true),
            close: closeChat
        };
    })();
    </script>

</body>
</html>
